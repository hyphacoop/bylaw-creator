# Password users enter to access the app (required)
APP_PASSWORD=change-me

# Secret used to sign session cookies (required in production).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Ollama API. Either a base URL (http://localhost:11434) or a full /api/generate URL.
# From Docker, use http://host.docker.internal:11434 to reach Ollama on the host.
OLLAMA_URL=http://localhost:11434
# Optional HTTP basic auth for the Ollama API (leave blank if not needed)
OLLAMA_USERNAME=
OLLAMA_PASSWORD=
# Generation tuning (optional)
# Max tokens generated per request (default 12000)
# OLLAMA_NUM_PREDICT=12000
# Context window; unset uses the Ollama server/model default
# OLLAMA_NUM_CTX=16384
# Let reasoning models think before answering (default false). Thinking uses up the
# token budget and can cut the bylaws short, so leave it off unless you raise OLLAMA_NUM_PREDICT.
# OLLAMA_THINK=false

# Set to true when the app is served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=false

# Port for the Express server (API, plus the built UI in production/Docker)
PORT=4000

# Only needed if the frontend is served from a different origin than the API
# FRONTEND_URL=http://localhost:3000
# REACT_APP_API_URL=http://localhost:4000
